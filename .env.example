# ---- Smartsheet OAuth app -------------------------------------------------
# Create at: https://app.smartsheet.com  ->  Account  ->  Developer Tools
#   App URL:          https://github.com/<you>/cn4m-smartsync
#   App redirect URL: http://localhost:2646/callback
SMARTSHEET_CLIENT_ID=
SMARTSHEET_CLIENT_SECRET=

# Optional: a personal API token (Account -> Personal Settings -> API Access).
# If set, the OAuth flow is skipped entirely and this token is used instead.
SMARTSHEET_ACCESS_TOKEN=

# Where to write. Start the container and open http://localhost:2646/sheets
# to look these ids up.
#
# A REPORT acts as a row filter: only rows visible in the report are eligible
# to match, so deprecated rows sitting in the underlying sheet are never
# touched. Columns are still resolved against the source sheet, so a report
# does not have to display the columns being written.
#
# Set ONE of these. If both are set, the report wins.
SMARTSHEET_REPORT_ID=
SMARTSHEET_SHEET_ID=

# Column titles in Smartsheet. NAME is the match key; the others are written.
# Leave a title BLANK to switch that column off entirely.
#
# When several Google Sheet rows share a NAME, each column is reduced across
# the group independently: the highest VERSION and the latest PROCESSED, which
# may well come from different rows. A VERSION is truncated at its first
# underscore first, so v001_hapaudio and v001_30fps_b both count as v001. The
# leading emoji is kept, so the cell reads "☝️ v001".
SMARTSHEET_NAME_COLUMN=NAME
SMARTSHEET_VERSION_COLUMN=VERSION
SMARTSHEET_PROCESSED_COLUMN=PROCESSED
SMARTSHEET_STATUS_COLUMN=
SMARTSHEET_NOTES_COLUMN=

# Composite columns, assembled from the GOOGLE_*_TEMPLATE values below.
SMARTSHEET_FORMAT_COLUMN=
SMARTSHEET_AUDIO_COLUMN=
SMARTSHEET_MISC_COLUMN=

# Duration is switched off for now. Set a column title here to re-enable it;
# it takes its value from the latest-processed row in each group.
SMARTSHEET_DURATION_COLUMN=

# ---- Google Sheet ---------------------------------------------------------
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=

# Optional: address the tab by title instead of by gid.
GOOGLE_SHEET_TAB=

# Column titles in the Google Sheet, matched case-insensitively.
# NAME and PROCESSED are required. The rest may be absent, in which case that
# field is simply left empty.
#   NAME      -> matched against the Smartsheet match column
#   PROCESSED -> the timestamp that decides which rows count as new
#   VERSION   -> written to Smartsheet (highest across rows sharing a NAME)
#   DURATION  -> only used when SMARTSHEET_DURATION_COLUMN is set
#   FILENAME  -> used in the Discord "no match found" message
# Open http://localhost:2646/columns to check these against the real sheet.
GOOGLE_NAME_COLUMN=NAME
GOOGLE_PROCESSED_COLUMN=PROCESSED
GOOGLE_VERSION_COLUMN=VERSION
GOOGLE_DURATION_COLUMN=DURATION
GOOGLE_FILENAME_COLUMN=FILENAME
GOOGLE_STATUS_COLUMN=STATUS
GOOGLE_NOTES_COLUMN=NOTES

# Composite values, built from several source columns at once.
#   {COL}   is replaced by that column's value (case-insensitive).
#   [ ... ] is dropped ENTIRELY if any placeholder inside it is blank.
# The brackets are what stop a still -- no CODEC, no FPS, no audio -- from
# rendering as ", 6912 x 3840 @ ". Examples with the defaults below:
#   movie -> "NotchLC, 6912 x 3840 @ 30.000"   /   "2ch PCM @ 48000k, 16bit"
#   still -> "6912 x 3840"                     /   "" (cell left untouched)
GOOGLE_FORMAT_TEMPLATE=[{CODEC}][, {WIDTH} x {HEIGHT}][ @ {FPS}]
GOOGLE_AUDIO_TEMPLATE=[{CH}ch ][{AUDIO}][ @ {RATE}Hz][, {BITS}bit]
# Misc pairs the duration with the filename: "00:00:30:00, clip_v001.mov".
# A row with no DURATION renders just the filename.
GOOGLE_MISC_TEMPLATE=[{DURATION}][, {FILENAME}]

# GOOGLE_CREDS: paste the entire contents of your service account JSON key file
#   as a single line (no line breaks inside the value).
#
# Create one at console.cloud.google.com -> IAM & Admin -> Service Accounts ->
# Keys -> Add Key -> JSON, with the Google Sheets API enabled on the project.
# Then share the spreadsheet with that account's client_email as a Viewer.
#
# Leave blank to fall back to the public CSV export, which only works for
# sheets shared as "anyone with the link can view".
GOOGLE_CREDS=

# Alternatives, if pasting the key inline is awkward:
#   GOOGLE_CREDS also accepts base64-encoded JSON.
#   GOOGLE_CREDS_FILE points at a mounted key file, e.g. /data/gcp-key.json
GOOGLE_CREDS_FILE=

# ---- Discord --------------------------------------------------------------
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# ---- Behaviour ------------------------------------------------------------
# How much of the sheet each pass looks at.
#   reconcile (default) - every pass matches ALL rows and writes any cell that
#     differs, so a row can never be permanently missed by a stale read or a
#     failed pass. Writes are diffed, so a pass with nothing to do writes
#     nothing. The watermark then only suppresses repeat Discord messages.
#   watermark - only rows newer than the watermark are looked at at all.
# reconcile makes the Google Sheet continuously authoritative: a manual edit to
# a synced Smartsheet cell is reverted within one interval.
SYNC_MODE=reconcile

SYNC_INTERVAL_SECONDS=60
PORT=2646

# Log what would change without writing to Smartsheet or Discord.
DRY_RUN=false

# Never overwrite a populated Smartsheet cell with a blank Google Sheet value.
SKIP_BLANK_VALUES=true

LOG_LEVEL=info

# ---- Optional overrides ---------------------------------------------------
# Both already have working defaults. Leave them commented out unless you
# actually need to change one.
#
# IMPORTANT: do not add DATA_DIR as an empty line. An empty value overrides the
# container's DATA_DIR=/data and sends tokens.json to ./data inside the image
# instead of the mounted volume, so they would be lost on the next rebuild.
#
# SMARTSHEET_SCOPES=READ_SHEETS WRITE_SHEETS   # changing this needs a reauthorize
# DATA_DIR=/data                               # already set by the Dockerfile
